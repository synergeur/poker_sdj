# Public client configuration only.
# Vite exposes every VITE_ variable to the browser.
# Never put private service-account credentials or other secrets here.

VITE_APP_NAME=Poker Room Manager
VITE_APP_ENV=development

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_USE_MOCK_DATA=true
VITE_ENABLE_FIREBASE=false
