# Public Supabase values. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never expose this in client code or commit a real value.
SUPABASE_SECRET_KEY=

# Apex origin, without a trailing path. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Host used to tell the apex from an organization subdomain.
# Local: localhost  ->  http://localhost:3000/sign-in
#         casino.localhost:3000/home is that organization's home.
# Production example: domain.com
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# Sign-in uses an account ID and password, not an email address and not a public registration.
# Supabase Auth still stores an email. The app uses {accountId}@id.casinoroom.app internally.
# People never type that email.
#
# Before the first sign-in:
# 1. In the Supabase dashboard, disable public sign-ups (Authentication settings).
#    This repository cannot switch that off for a hosted project.
# 2. Add the host user with email host@id.casinoroom.app, a password, and auto-confirm.
#    The account ID they type is "host" unless you choose another local-part.
# 3. Insert that user's id into platform_admins. See supabase/seed.sql.
# 4. Apply supabase/migrations.
